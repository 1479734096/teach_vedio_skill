  "equations": {
    "kvl_loop": "V0 = v_R(t) + v_C(t) = R * i(t) + v_C(t)",
    "differential_equation": "R * C * (dv_C/dt) + v_C(t) = V0  ==>  tau * (dv_C/dt) + v_C = V0",
    "charging_voltage": "v_C(t) = V0 * (1 - exp(-t / tau))",
    "charging_current": "i(t) = (V0 / R) * exp(-t / tau) = I0 * exp(-t / tau)",
    "discharging_voltage": "v_C(t) = V0 * exp(-t / tau)",
    "discharging_current": "i(t) = -(V0 / R) * exp(-t / tau) = -I0 * exp(-t / tau)",
    "characteristic_tau_point": "t = tau 时, v_C(tau) = V0 * (1 - 1/e) ≈ 63.21% V0 = 6.321 V, i(tau) = 36.79% I0",
    "steady_state_point": "t = 4 * tau 时, v_C(4*tau) = V0 * (1 - exp(-4)) ≈ 98.17% V0",
    "energy_theorem": "E_source = C * V0^2 = 0.10 J; E_C = 0.5 * C * V0^2 = 0.05 J (50%); E_R = 0.05 J (50%)"
  },

      "t_state": "完全重合峰值",
      "overlap_area_max": true,
      "nature": "两门信号完全重合，输出达到三角形峰值"
    },
    {
      "t_state": "滑出下降",
      "overlap_area_linear": true,
      "nature": "重叠面积随时间线性衰减"
    },
    {
      "t_state": "完全脱离",
      "overlap_area": 0.0,
      "nature": "滑出有效区间，卷积输出归零"
    }

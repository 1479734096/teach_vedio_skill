    "topic": "convolution",
    "domain_note": "连续时间信号卷积积分机制：(f * g)(t) = ∫ f(τ) g(t - τ) dτ，通过哑变量 τ 坐标系下的镜像翻转、时延平移、重叠相乘与面积积分累积展示。",
    "parameters": {
      "pulse_width_px": 200,
      "pulse_height_px": 120,
      "slide_speed_px_s": 100,
      "area_f": 1.0,
      "area_g": 1.0,
      "tau_min_px": -750,
      "tau_max_px": 750
    },
    "coordinates": {
      "screen_origin_X0": 960,
      "screen_baseline_Y0": 550,
      "x_min_px": -750,
      "x_max_px": 750
    },
    "equations": {
      "definition": "(f * g)(t) = \\int_{-\\infty}^{\\infty} f(\\tau) g(t - \\tau) d\\tau",
      "step1_mirror": "g(\\tau) \\to g(-\\tau) (关于 \\tau=0 垂直镜像翻转)",
      "step2_shift": "g(-\\tau) \\to g(t - \\tau) (沿 \\tau 轴向右平移 t)",
      "step3_multiply": "w(\\tau; t) = f(\\tau) \\cdot g(t - \\tau) (重叠相乘取交集)",
      "step4_integrate": "y(t) = \\int w(\\tau; t) d\\tau (重叠区域面积随时间累积)"
    },
    "checkpoints": [
